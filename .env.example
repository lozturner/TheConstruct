# TheConstruct configuration — copy to .env and fill in.

# General
OUTPUT_DIR=./out
HEADLESS=true
LOG_LEVEL=INFO
USER_DATA_DIR=~/.cache/theconstruct

# Voice cloning
# Path to a clean ~30s audio sample of the voice to clone.
SAMPLE_VOICE_PATH=./fixtures/sample.wav
# Skip cloning by reusing a known voice id.
DEFAULT_VOICE_ID=

# Browser-driven service (PlayHT by default)
VOICE_SERVICE=playht
VOICE_SERVICE_EMAIL=
VOICE_SERVICE_PASSWORD=

# Optional API fallback — if set, the browser path is bypassed.
ELEVENLABS_API_KEY=
